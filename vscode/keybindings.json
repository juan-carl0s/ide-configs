// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "cmd+k cmd+/",
    "command": "workbench.action.splitEditorDown",
  },
  {
    "key": "shift+cmd+3",
    "command": "workbench.files.action.collapseExplorerFolders",
  },
  {
    "key": "ctrl+n",
    "command": "explorer.newFile",
    "when": "explorerViewletFocus",
  },
  {
    "key": "ctrl+shift+n",
    "command": "explorer.newFolder",
    "when": "explorerViewletFocus",
  },
  {
    "key": "shift+cmd+t shift+cmd+c",
    "command": "go.test.coverage",
  },
  {
    "key": "tab",
    "command": "tab",
    "when": "editorTextFocus && !editorTabMovesFocus",
  },
  {
    "key": "shift+tab",
    "command": "outdent",
    "when": "editorTextFocus && !editorTabMovesFocus",
  },
  {
    "key": "shift+cmd+t shift+cmd+p",
    "command": "go.test.package",
  },
  {
    "key": "cmd+t cmd+f",
    "command": "go.test.generate.function",
  },
  {
    "key": "shift+cmd+t shift+cmd+a",
    "command": "go.test.workspace",
  },
  {
    "key": "tab",
    "command": "editor.action.inlineSuggest.commit",
    "when": "inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorTabMovesFocus",
  },
  {
    "key": "tab",
    "command": "-editor.action.inlineSuggest.commit",
    "when": "inlineSuggestionHasIndentationLessThanTabSize && inlineSuggestionVisible && !editorTabMovesFocus",
  },
  {
    "key": "shift+cmd+g",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active",
  },
  {
    "key": "ctrl+shift+g",
    "command": "-workbench.view.scm",
    "when": "workbench.scm.active",
  },
  {
    "key": "cmd+k cmd+t",
    "command": "editor.action.peekTypeDefinition",
  },
  {
    "key": "shift+f6",
    "command": "editor.emmet.action.matchTag",
  },
  {
    "key": "f6",
    "command": "-workbench.action.focusNextPart",
  },
  {
    "key": "cmd+k cmd+t",
    "command": "-workbench.action.selectTheme",
  },
  {
    "key": "alt+cmd+c alt+cmd+h",
    "command": "workbench.panel.chat.view.copilot.focus",
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n",
    },
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "shift+cmd+]",
    "command": "-workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "shift+cmd+[",
    "command": "-workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus",
  },
  {
    "key": "f12",
    "command": "editor.action.revealDefinition",
    "when": "editorHasDefinitionProvider && editorTextFocus",
  },
  {
    "key": "f12",
    "command": "-editor.action.revealDefinition",
    "when": "editorHasDefinitionProvider && editorTextFocus",
  },
  {
    "key": "ctrl+shift+=",
    "command": "workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "ctrl+shift+`",
    "command": "-workbench.action.terminal.new",
    "when": "terminalProcessSupported || terminalWebExtensionContributedProfile",
  },
  {
    "key": "cmd+k cmd+d",
    "command": "editor.action.peekDefinition",
    "when": "editorHasDefinitionProvider && !inReferenceSearchEditor && !isInEmbeddedEditor",
  },
  {
    "key": "ctrl+`",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active",
  },
  {
    "key": "ctrl+`",
    "command": "-workbench.action.terminal.toggleTerminal",
    "when": "terminal.active",
  },
  {
    "key": "alt+cmd+c",
    "command": "copyRelativeFilePath",
    "when": "editorFocus",
  },
  {
    "key": "alt+cmd+c",
    "command": "-copyFilePath",
    "when": "!editorFocus",
  },
]
